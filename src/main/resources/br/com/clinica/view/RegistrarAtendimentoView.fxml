<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="main-stage-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.clinica.controller.RegistrarAtendimentoController">
    <content>
        <StackPane minHeight="900.0" style="-fx-background-color: transparent;">
            <children>
                <VBox maxWidth="800.0" spacing="18.0" styleClass="card-container">
                    <children>
                        <!-- Cabeçalho -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="title-medium" text="Registrar Atendimento Médico" />
                                                <Label styleClass="badge-uc" text="UC07" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="subtitle" text="Preenchimento do Prontuário Clínico, Sinais Vitais, Diagnóstico e Prescrições" />
                                    </children>
                                </VBox>
                                <Button onAction="#handleVoltar" styleClass="btn-secondary" text="← Voltar" />
                            </children>
                        </HBox>

                        <!-- Tabela de Seleção da Consulta -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="field-label" text="1. Selecione a Consulta do Paciente para Atendimento:" />
                                <TableView fx:id="tvConsultas" prefHeight="150.0">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                        <TableColumn fx:id="colPaciente" prefWidth="150.0" text="Paciente" />
                                        <TableColumn fx:id="colTutor" prefWidth="150.0" text="Tutor" />
                                        <TableColumn fx:id="colData" prefWidth="100.0" text="Data" />
                                        <TableColumn fx:id="colHorario" prefWidth="80.0" text="Horário" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- Prontuário Médico -->
                        <VBox spacing="14.0" style="-fx-background-color: rgba(0,0,0,0.22); -fx-padding: 16; -fx-background-radius: 12;">
                            <children>
                                <Label fx:id="lblPacienteInfo" style="-fx-text-fill: #6ee7b7; -fx-font-weight: bold; -fx-font-size: 13px;" text="2. Prontuário Eletrônico (Selecione uma consulta na tabela acima)" />

                                <!-- Sinais Vitais -->
                                <GridPane hgap="12.0" vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="33.3" />
                                        <ColumnConstraints percentWidth="33.3" />
                                        <ColumnConstraints percentWidth="33.3" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="4.0" GridPane.columnIndex="0">
                                            <children>
                                                <Label styleClass="field-label" text="Peso (kg)" />
                                                <TextField fx:id="txtPeso" promptText="Ex: 12.5" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" GridPane.columnIndex="1">
                                            <children>
                                                <Label styleClass="field-label" text="Temperatura (°C)" />
                                                <TextField fx:id="txtTemperatura" promptText="Ex: 38.4" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" GridPane.columnIndex="2">
                                            <children>
                                                <Label styleClass="field-label" text="Frequência Cardíaca (bpm)" />
                                                <TextField fx:id="txtFrequencia" promptText="Ex: 110" />
                                            </children>
                                        </VBox>
                                    </children>
                                    <rowConstraints>
                                        <RowConstraints />
                                    </rowConstraints>
                                </GridPane>

                                <!-- Diagnóstico -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Diagnóstico Clínico *" />
                                        <TextArea fx:id="txtDiagnostico" prefRowCount="2" promptText="Descreva a avaliação clínica, suspeitas diagnósticas ou achados clínicos..." />
                                    </children>
                                </VBox>

                                <!-- Procedimentos -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Procedimentos Realizados *" />
                                        <TextArea fx:id="txtProcedimentos" prefRowCount="2" promptText="Ex: Aplicação de vacina, curativo, coleta de sangue, limpeza de conduto..." />
                                    </children>
                                </VBox>

                                <!-- Prescrição -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Prescrição Medicamentosa / Receita *" />
                                        <TextArea fx:id="txtPrescricao" prefRowCount="3" promptText="Medicamentos, dosagens, posologia e período de tratamento..." />
                                    </children>
                                </VBox>

                                <!-- Recomendações -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Orientações e Recomendações ao Tutor" />
                                        <TextArea fx:id="txtRecomendacoes" prefRowCount="2" promptText="Repouso, alimentação específica, data de retorno recomendada..." />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Botões de Ação -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 6 0 0 0;">
                            <children>
                                <Button onAction="#handleVoltar" styleClass="btn-secondary" text="Cancelar" />
                                <Button onAction="#handleSalvarAtendimento" styleClass="btn-primary" text="Salvar Prontuário &amp; Finalizar Consulta" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                    </padding>
                </VBox>
            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
        </StackPane>
    </content>
</ScrollPane>

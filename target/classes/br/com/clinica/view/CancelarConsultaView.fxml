<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="main-stage-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.clinica.controller.CancelarConsultaController">
    <content>
        <StackPane minHeight="740.0" style="-fx-background-color: transparent;">
            <children>
                <VBox maxWidth="780.0" spacing="18.0" styleClass="card-container">
                    <children>
                        <!-- Cabeçalho -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="title-medium" text="Cancelar Consulta" />
                                                <Label style="-fx-background-color: rgba(239, 68, 68, 0.2); -fx-text-fill: #fca5a5; -fx-padding: 2 6; -fx-background-radius: 6; -fx-font-size: 11px; -fx-font-weight: bold;" text="UC06" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="subtitle" text="Desmarque a consulta e libere o horário da agenda médica" />
                                    </children>
                                </VBox>
                                <Button onAction="#handleVoltar" styleClass="btn-secondary" text="← Voltar" />
                            </children>
                        </HBox>

                        <!-- Tabela de Consultas Agendadas -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="field-label" text="1. Selecione a Consulta para Cancelar:" />
                                <TableView fx:id="tvConsultas" prefHeight="170.0">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                        <TableColumn fx:id="colPaciente" prefWidth="140.0" text="Paciente" />
                                        <TableColumn fx:id="colTutor" prefWidth="140.0" text="Tutor" />
                                        <TableColumn fx:id="colData" prefWidth="95.0" text="Data" />
                                        <TableColumn fx:id="colHorario" prefWidth="70.0" text="Horário" />
                                        <TableColumn fx:id="colVeterinario" prefWidth="220.0" text="Veterinário" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- Painel de Confirmação & Justificativa -->
                        <VBox spacing="12.0" style="-fx-background-color: rgba(239,68,68,0.08); -fx-border-color: rgba(239,68,68,0.25); -fx-border-radius: 12; -fx-padding: 16; -fx-background-radius: 12;">
                            <children>
                                <Label fx:id="lblConsultaInfo" style="-fx-text-fill: #fca5a5; -fx-font-weight: bold; -fx-font-size: 13px;" text="2. Selecione uma consulta acima para registrar o cancelamento" />

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Motivo / Justificativa do Cancelamento *" />
                                        <TextArea fx:id="txtMotivoCancelamento" prefRowCount="3" promptText="Informe a razão informada pelo tutor ou imprevisto clínico..." />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Botões de Ação -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 6 0 0 0;">
                            <children>
                                <Button onAction="#handleVoltar" styleClass="btn-secondary" text="Voltar" />
                                <Button onAction="#handleConfirmarCancelamento" styleClass="btn-danger" text="Confirmar Cancelamento da Consulta" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                    </padding>
                </VBox>
            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
        </StackPane>
    </content>
</ScrollPane>

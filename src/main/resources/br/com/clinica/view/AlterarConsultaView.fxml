<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="main-stage-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.clinica.controller.AlterarConsultaController">
    <content>
        <StackPane minHeight="780.0" style="-fx-background-color: transparent;">
            <children>
                <VBox maxWidth="780.0" spacing="18.0" styleClass="card-container">
                    <children>
                        <!-- Cabeçalho -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="title-medium" text="Alterar Consulta" />
                                                <Label styleClass="badge-uc" text="UC05" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="subtitle" text="Selecione uma consulta agendada na tabela abaixo para editar data, horário ou profissional" />
                                    </children>
                                </VBox>
                                <Button onAction="#handleVoltar" styleClass="btn-secondary" text="← Voltar" />
                            </children>
                        </HBox>

                        <!-- Tabela de Consultas Agendadas -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="field-label" text="1. Selecione a Consulta para Alterar:" />
                                <TableView fx:id="tvConsultas" prefHeight="170.0">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                        <TableColumn fx:id="colPaciente" prefWidth="140.0" text="Paciente" />
                                        <TableColumn fx:id="colTutor" prefWidth="140.0" text="Tutor" />
                                        <TableColumn fx:id="colData" prefWidth="95.0" text="Data" />
                                        <TableColumn fx:id="colHorario" prefWidth="70.0" text="Horário" />
                                        <TableColumn fx:id="colVeterinario" prefWidth="220.0" text="Veterinário" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- Formulário de Alteração -->
                        <VBox spacing="14.0" style="-fx-background-color: rgba(0,0,0,0.2); -fx-padding: 16; -fx-background-radius: 12;">
                            <children>
                                <Label fx:id="lblConsultaSelecionada" style="-fx-text-fill: #00c49f; -fx-font-weight: bold; -fx-font-size: 13px;" text="2. Dados da Consulta Selecionada (Selecione na tabela acima):" />

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Veterinário Responsável *" />
                                        <ComboBox fx:id="cbVeterinario" maxWidth="1.7976931348623157E308" />
                                    </children>
                                </VBox>

                                <GridPane hgap="14.0" vgap="14.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0" />
                                        <ColumnConstraints percentWidth="50.0" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="6.0" GridPane.columnIndex="0">
                                            <children>
                                                <Label styleClass="field-label" text="Nova Data *" />
                                                <DatePicker fx:id="dpNovaData" maxWidth="1.7976931348623157E308" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1">
                                            <children>
                                                <Label styleClass="field-label" text="Novo Horário *" />
                                                <ComboBox fx:id="cbNovoHorario" maxWidth="1.7976931348623157E308" />
                                            </children>
                                        </VBox>
                                    </children>
                                    <rowConstraints>
                                        <RowConstraints />
                                    </rowConstraints>
                                </GridPane>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Motivo da Consulta / Observações *" />
                                        <TextField fx:id="txtNovoMotivo" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Botões de Ação -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 6 0 0 0;">
                            <children>
                                <Button onAction="#handleVoltar" styleClass="btn-secondary" text="Cancelar" />
                                <Button onAction="#handleSalvarAlteracao" styleClass="btn-primary" text="Salvar Alteração" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                    </padding>
                </VBox>
            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
        </StackPane>
    </content>
</ScrollPane>

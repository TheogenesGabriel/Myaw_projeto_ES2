<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Repare que aqui eu chamei o mesmo paciente-style.css que você criou antes -->
<HBox fx:controller="com.myow.TutorController" prefHeight="600.0" prefWidth="900.0" stylesheets="@paciente-style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">      
      <!-- Lado Esquerdo: Área da Logo (Fundo Branco) -->
      <VBox alignment="CENTER" prefWidth="450.0" styleClass="painel-esquerdo">
         <children>
            <ImageView fitHeight="200.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/logo.png" />
               </image>
            </ImageView>
         </children>
      </VBox>

      <!-- Lado Direito: Formulário (Fundo Verde Escuro) -->
      <VBox alignment="CENTER_LEFT" prefWidth="450.0" spacing="15.0" styleClass="painel-direito" HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
         </padding>
         <children>
            
            <Label styleClass="titulo" text="Cadastrar Tutor">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            
            <!-- Grupo: Nome Completo -->
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="label-form" text="Nome Completo *" />
                  <TextField fx:id="txtNomeTutor" promptText="Ex: João da Silva" styleClass="caixa-texto" />
               </children>
            </VBox>
            
            
            
            <!-- Grupo: E-mail -->
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="label-form" text="E-mail" />
                  <TextField fx:id="txtEmail" promptText="exemplo@email.com" styleClass="caixa-texto" />
               </children>
            </VBox>
            
            <!-- Grupo: CPF -->
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="label-form" text="CPF *" />
                  <TextField fx:id="txtCpf" promptText="000.000.000-00" styleClass="caixa-texto" />
               </children>
            </VBox>

            <!-- Grupo: Telefone -->
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="label-form" text="Telefone *" />
                  <TextField fx:id="txtTelefone" promptText="(00) 00000-0000" styleClass="caixa-texto" />
               </children>
            </VBox>

            <!-- Grupo: Endereço -->
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="label-form" text="Endereço" />
                  <TextField fx:id="txtEndereco" promptText="Rua, Número, Bairro, Cidade" styleClass="caixa-texto" />
               </children>
            </VBox>
            
            <!-- Botão Cadastrar -->
            <Button fx:id="btnCadastrarTutor" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="botao-cadastrar" text="Cadastrar →" onAction="#salvarTutor">
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </Button>
            
         </children>
      </VBox>
   </children>
</HBox>